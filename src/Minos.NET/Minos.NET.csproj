<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Minos</RootNamespace>
    <PackageId>Minos.NET</PackageId>
    <Title>Minos.NET</Title>
    <Description>Unofficial .NET client for TypeSafe AI's Jev System One model, directly or through OpenRouter. Source-generated, Native AOT-compatible and allocation-conscious, with typed questions and answers and Result-based errors. Not affiliated with or endorsed by TypeSafe AI.</Description>
    <!--
      Trim- and AOT-safe by design. The one reflection, EnumOptionSet reading an enum's public fields for question sets
      built at run time, is declared through DynamicallyAccessedMembers, so the trimmer keeps those fields. Enables
      IsTrimmable and the trim and AOT analyzers.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SystemOneJsonEncoder overrides JavaScriptEncoder's pointer-based members. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      ZeroAlloc.Validation's generator emits every {Model}Validator internal: they check this library's internal
      question specs and are no part of its API. Every ZeroAlloc generator reads this one property; the
      ZeroAlloc.Rest output it also covers is internal already.
    -->
    <ZeroAllocGeneratedAccessibility>Internal</ZeroAllocGeneratedAccessibility>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build the [Questions] source generator, its analyzer and its code fixes first and ship them in this
      package under analyzers/dotnet/cs. Minos.NET itself does not run any of them, and none may become a
      package dependency.
    -->
    <ProjectReference Include="..\Minos.NET.Generator\Minos.NET.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Minos.NET.Analyzers\Minos.NET.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\Minos.NET.CodeFixes\Minos.NET.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minos.NET.Tests" />
    <!-- The benchmarks time the internal parse of a built set in isolation, which no public member exposes. -->
    <InternalsVisibleTo Include="Minos.NET.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- ILogger and the [LoggerMessage] generator; a runtime dependency that flows to consumers. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Results" />
    <!--
      PrivateAssets keeps ZeroAlloc.Validation's build and buildtransitive assets out of consumers' builds, and the
      nuspec excludes its Build and Analyzers. NuGet still flows the analyzers transitively, NuGet/Home#6720, where
      they stay inert without [Validate] types. The runtime library flows as usual.
    -->
    <PackageReference Include="ZeroAlloc.Validation" PrivateAssets="analyzers;build;buildtransitive" />
    <!--
      The [Instrument] attributes flow to consumers at run time; the bundled proxy generator runs for this library only.
      PrivateAssets keeps its build and buildtransitive assets out of consumers' builds and the nuspec excludes its
      Build and Analyzers, as for ZeroAlloc.Validation. NuGet may still flow the analyzer, NuGet/Home#6720, where it
      stays inert without [Instrument]; the pack tests check that no source is generated.
    -->
    <PackageReference Include="ZeroAlloc.Telemetry" PrivateAssets="analyzers;build;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule ids, shared with the generator and the analyzers, so a runtime failure names the same MIN id. -->
    <Compile Include="..\Minos.NET.Generator\DiagnosticIds.cs" Link="Shared\DiagnosticIds.cs" />
    <Compile Include="..\Minos.NET.Generator\DecisionLimits.cs" Link="Shared\DecisionLimits.cs" />
    <!-- One snake_case algorithm for the generator's keys and the runtime option sets. -->
    <Compile Include="..\Minos.NET.Generator\SnakeCase.cs" Link="Shared\SnakeCase.cs" />
  </ItemGroup>

  <!-- Pack the generator, analyzer and code fixes from their real build output rather than a hard-coded bin path (#14). -->
  <Target Name="PackDecisionGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Minos.NET.Generator\Minos.NET.Generator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DecisionAnalyzerAssemblies" />
    </MSBuild>
    <MSBuild Projects="..\Minos.NET.Analyzers\Minos.NET.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DecisionAnalyzerAssemblies" />
    </MSBuild>
    <MSBuild Projects="..\Minos.NET.CodeFixes\Minos.NET.CodeFixes.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DecisionAnalyzerAssemblies" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_DecisionAnalyzerAssemblies)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
